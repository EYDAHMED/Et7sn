rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A super admin is any account that has a document in /admins/{uid}.
    // Those documents can only be created from the Firebase console.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validWeight(value) {
      return value is number && value >= 25 && value <= 400;
    }

    // Admin marker documents: a user may only check their own.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Profiles. Owner and super admin can read; only the owner can write.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && validWeight(request.resource.data.weightKg)
        && validWeight(request.resource.data.startWeightKg);

      // username and startWeightKg can never change after creation.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'age', 'heightCm', 'weightKg', 'gender', 'activity',
          'workoutDays', 'goal', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && validWeight(request.resource.data.weightKg);

      allow delete: if false;

      // Weekly weight check-ins (document id "w<weekIndex>").
      match /weights/{weekId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && validWeight(request.resource.data.weightKg);
        allow delete: if false;
      }

      // The meals a user picked for a day.
      match /mealDays/{day} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }
    }

    // Public leaderboard summary: every signed-in member can read it,
    // each member can only write their own row.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && validWeight(request.resource.data.currentWeightKg)
        && validWeight(request.resource.data.startWeightKg)
        && validWeight(request.resource.data.prevWeightKg);
      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
